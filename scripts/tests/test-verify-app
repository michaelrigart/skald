#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: $0 <Release Skald.app> <Debug Skald.app>" >&2
  exit 2
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
verify="$root/scripts/verify-app"
entitlements="$root/Skald/Skald.entitlements"
app="$1"
debug_app="$2"
team=CX4MWR5579

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

failures=0
cases=0

fresh_copy() {
  local dir
  dir="$(mktemp -d "$work/case.XXXXXX")"
  ditto "${1:-$app}" "$dir/Skald.app"
  echo "$dir/Skald.app"
}

resign() {
  codesign --force --sign - --options runtime --entitlements "$1" "$2" 2>/dev/null
}

resign_after_plist_edit() {
  /usr/libexec/PlistBuddy -c "$1" "$2/Contents/Info.plist"
  resign "$entitlements" "$2"
}

check() {
  local name="$1" expected="$2"
  shift 2
  cases=$((cases + 1))
  if "$@" >/dev/null 2>&1; then
    actual=pass
  else
    actual=fail
  fi
  if [[ "$actual" == "$expected" ]]; then
    echo "ok   $name"
  else
    echo "FAIL $name: expected $expected, got $actual" >&2
    failures=$((failures + 1))
  fi
}

check_run() {
  local name="$1" expected_status="$2" expected_stderr="$3" status=0 err
  shift 3
  cases=$((cases + 1))
  err="$("$@" 2>&1 >/dev/null)" || status=$?
  if [[ "$status" -eq "$expected_status" && "$err" == *"$expected_stderr"* ]]; then
    echo "ok   $name"
    if [[ -n "$err" ]]; then
      echo "$err" | sed 's/^/       /'
    fi
  else
    echo "FAIL $name: expected status $expected_status with '$expected_stderr', got status $status and '$err'" >&2
    failures=$((failures + 1))
  fi
}

copy="$(fresh_copy)"
check "a: a built app passes" pass "$verify" "$copy"

copy="$(fresh_copy)"
check "b: baseline passes" pass "$verify" "$copy"
extra="$work/extra.entitlements"
cat >"$extra" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.get-task-allow</key>
	<true/>
</dict>
</plist>
PLIST
resign "$extra" "$copy"
check_run "b: an added get-task-allow entitlement fails" 1 "entitlements are not empty" "$verify" "$copy"

copy="$(fresh_copy)"
check "c: baseline passes" pass "$verify" "$copy"
check "c: a dev build passes against the version dev" pass "$verify" "$copy" dev
check_run "c: a dev build fails against a release version" 1 "CFBundleShortVersionString is" "$verify" "$copy" 20261101-1430

copy="$(fresh_copy)"
resign "$entitlements" "$copy"
check "d: re-signed with the exact entitlements passes" pass "$verify" "$copy"
check_run "d: an ad hoc signature fails --team" 1 "TeamIdentifier is" "$verify" --team "$team" "$copy"

copy="$(fresh_copy)"
check "e: baseline passes" pass "$verify" "$copy"
resign_after_plist_edit "Set :CFBundleIdentifier com.example.other" "$copy"
check_run "e: another bundle identifier fails" 1 "bundle identifier is 'com.example.other'" "$verify" "$copy"

copy="$(fresh_copy)"
check "f: baseline passes" pass "$verify" "$copy"
resign_after_plist_edit "Set :LSUIElement false" "$copy"
check_run "f: LSUIElement false fails" 1 "LSUIElement is not true" "$verify" "$copy"

copy="$(fresh_copy)"
check "g: baseline passes" pass "$verify" "$copy"
resign_after_plist_edit "Set :CFBundleShortVersionString 20261101-1430" "$copy"
resign_after_plist_edit "Set :CFBundleVersion 202611011430" "$copy"
check "g: matching version passes" pass "$verify" "$copy" 20261101-1430
resign_after_plist_edit "Set :CFBundleShortVersionString 20261101-1431" "$copy"
check_run "g: a marketing version that differs fails" 1 "CFBundleShortVersionString is '20261101-1431'" "$verify" "$copy" 20261101-1430
resign_after_plist_edit "Set :CFBundleShortVersionString 20261101-1430" "$copy"
resign_after_plist_edit "Set :CFBundleVersion 0" "$copy"
check_run "g: a build number that is not the version's digits fails" 1 "CFBundleVersion is '0'" "$verify" "$copy" 20261101-1430
resign_after_plist_edit "Set :CFBundleShortVersionString dev" "$copy"
resign_after_plist_edit "Set :CFBundleVersion 1" "$copy"
check_run "g: the version dev with a build number other than 0 fails" 1 "CFBundleVersion is '1', expected '0'" "$verify" "$copy" dev

copy="$(fresh_copy)"
check "h: baseline passes" pass "$verify" "$copy"
/usr/libexec/PlistBuddy -c "Set :CFBundleDisplayName Tampered" "$copy/Contents/Info.plist"
check_run "h: a modified bundle fails the signature check" 1 "signature does not verify" "$verify" "$copy"

copy="$(fresh_copy)"
check "i: baseline passes" pass "$verify" "$copy"
check_run "i: an empty --team is a usage error" 2 usage "$verify" --team "" "$copy"
check_run "i: --team without an ID is a usage error" 2 usage "$verify" --team

copy="$(fresh_copy)"
check "j: baseline passes" pass "$verify" "$copy"
codesign --remove-signature "$copy" 2>/dev/null
check_run "j: --team on an unsigned bundle still reports the team" 1 "TeamIdentifier is 'none'" "$verify" --team "$team" "$copy"

copy="$(fresh_copy "$debug_app")"
check_run "k: a Debug build, which contains the probe, fails" 1 "executable contains the probe" "$verify" "$copy"

# Optimized Swift can keep a short literal such as --probe out of the binary, so each probe
# pattern gets its own stand-in executable holding only that string.
standin() {
  local marker="$1" dir src
  dir="$(mktemp -d "$work/standin.XXXXXX")"
  src="$dir/main.c"
  printf '#include <stdio.h>\nconst char marker[] = "%s";\nint main(void) { puts(marker); return 0; }\n' "$marker" >"$src"
  cc -arch arm64 -o "$dir/Skald" "$src"
  local bundle
  bundle="$(fresh_copy)"
  cp "$dir/Skald" "$bundle/Contents/MacOS/Skald"
  resign "$entitlements" "$bundle"
  echo "$bundle"
}

copy="$(standin "no marker")"
check "m: a stand-in executable without a probe string passes" pass "$verify" "$copy"
copy="$(standin "--probe")"
check_run "m: the --probe flag alone fails" 1 "executable contains the probe" "$verify" "$copy"
copy="$(standin "~skald-probe~ ready")"
check_run "m: the probe marker alone fails" 1 "executable contains the probe" "$verify" "$copy"
copy="$(standin "probe")"
check "m: the word probe alone passes" pass "$verify" "$copy"

copy="$(fresh_copy)"
check_run "n: a wrong --team fails" 1 "TeamIdentifier is" "$verify" --team ZZZZZZZZZZ "$copy"
app_signature="$(codesign -dvv "$app" 2>&1)"
if grep -qx "TeamIdentifier=$team" <<<"$app_signature"; then
  copy="$(fresh_copy)"
  check "n: a team-signed build passes --team" pass "$verify" --team "$team" "$copy"
else
  echo "skip n: a team-signed build passes --team (skipped, ad-hoc build)"
fi

# codesign can exit 0 with only a warning on stderr and nothing on stdout; that must not read as "no entitlements".
stub="$work/stub"
mkdir -p "$stub"
cat >"$stub/codesign" <<'STUB'
#!/usr/bin/env bash
for argument in "$@"; do
  if [[ "$argument" == --entitlements ]]; then
    echo "warning: binary contains an invalid entitlements blob. The OS will ignore these entitlements." >&2
    exit 0
  fi
done
exec /usr/bin/codesign "$@"
STUB
chmod +x "$stub/codesign"
copy="$(fresh_copy)"
check "o: baseline passes" pass "$verify" "$copy"
check_run "o: a codesign warning instead of entitlements fails" 1 "could not read entitlements" env PATH="$stub:$PATH" "$verify" "$copy"

copy="$(fresh_copy)"
check "p: baseline passes" pass "$verify" "$copy"
codesign --force --sign - --entitlements "$entitlements" "$copy" 2>/dev/null
check_run "p: a signature without Hardened Runtime fails" 1 "Hardened Runtime" "$verify" "$copy"

copy="$(fresh_copy)"
check "q: baseline passes" pass "$verify" "$copy"
slices="$(mktemp -d "$work/slices.XXXXXX")"
printf 'int main(void) { return 0; }\n' >"$slices/main.c"
cc -arch x86_64 -o "$slices/x86_64" "$slices/main.c"
lipo -create "$copy/Contents/MacOS/Skald" "$slices/x86_64" -output "$slices/universal"
cp "$slices/universal" "$copy/Contents/MacOS/Skald"
resign "$entitlements" "$copy"
check_run "q: a universal executable fails" 1 "architectures are 'x86_64 arm64'" "$verify" "$copy"

copy="$(fresh_copy)"
check "r: baseline passes" pass "$verify" "$copy"
resign_after_plist_edit "Set :LSMinimumSystemVersion 26.0" "$copy"
check_run "r: a minimum system version of 26.0 fails" 1 "LSMinimumSystemVersion is '26.0'" "$verify" "$copy"
resign_after_plist_edit "Set :LSMinimumSystemVersion 9.0" "$copy"
check_run "r: a minimum system version of 9.0 fails" 1 "LSMinimumSystemVersion is '9.0'" "$verify" "$copy"
resign_after_plist_edit "Set :LSMinimumSystemVersion 27.1" "$copy"
check "r: a minimum system version of 27.1 passes" pass "$verify" "$copy"
resign_after_plist_edit "Delete :LSMinimumSystemVersion" "$copy"
check_run "r: a missing minimum system version fails" 1 "LSMinimumSystemVersion is 'none'" "$verify" "$copy"

if [[ $failures -ne 0 ]]; then
  echo "$failures of $cases cases failed" >&2
  exit 1
fi
echo "$cases of $cases cases passed"
